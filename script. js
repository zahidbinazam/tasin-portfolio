// Mobile Menu Navigation Toggle
const mobileMenu = document.querySelector('#mobile-menu');
const navLinks = document.querySelector('.nav-links');

if (mobileMenu && navLinks) {
    mobileMenu.addEventListener('click', () => {
        mobileMenu.classList.toggle('active');
        navLinks.classList.toggle('active');
    });

    // Close Mobile Menu on Link Click
    document.querySelectorAll('.nav-links a').forEach(link => {
        link.addEventListener('click', () => {
            mobileMenu.classList.remove('active');
            navLinks.classList.remove('active');
        });
    });
}

// Interactive Highlight: Active Section Navigation Indicators
const sections = document.querySelectorAll('section');
const navItems = document.querySelectorAll('.nav-links a');

window.addEventListener('scroll', () => {
    let currentSectionId = '';
    
    sections.forEach(section => {
        const sectionTop = section.offsetTop;
        const sectionHeight = section.clientHeight;
        if (window.scrollY >= (sectionTop - sectionHeight / 3)) {
            currentSectionId = section.getAttribute('id');
        }
    });

    navItems.forEach(item => {
        item.classList.remove('active');
        if (item.getAttribute('href') && item.getAttribute('href').includes(currentSectionId)) {
            item.classList.add('active');
        }
    });
});

// Single Line Live Typing Animation
const fullText = "Student | Web Developer | Problem Solver | Gamer 🎮";
let charIndex = 0;
const typingContainer = document.querySelector("#typed-line");

function typeEffect() {
    if (typingContainer) {
        if (charIndex < fullText.length) {
            typingContainer.textContent += fullText.charAt(charIndex);
            charIndex++;
            setTimeout(typeEffect, 60);
        }
    }
}

// Execute Typing on Page Load
document.addEventListener("DOMContentLoaded", typeEffect);
/* =========================
   LIVE TYPING HEADLINE
========================= */

const typingText = document.getElementById("typing-text");

const words = [
    "CSE Student",
    "Aspiring AI Engineer",
    "Web Developer",
    "Problem Solver",
    "Tech Enthusiast",
    "Future Software Engineer"
];

let wordIndex = 0;
let charIndex = 0;
let deleting = false;

function typeEffect() {

    const currentWord = words[wordIndex];

    if (!deleting) {

        typingText.textContent =
            currentWord.substring(0, charIndex + 1);

        charIndex++;

        if (charIndex === currentWord.length) {

            deleting = true;

            setTimeout(typeEffect, 1800);

            return;
        }

    } else {

        typingText.textContent =
            currentWord.substring(0, charIndex - 1);

        charIndex--;

        if (charIndex === 0) {

            deleting = false;

            wordIndex++;

            if (wordIndex === words.length) {
                wordIndex = 0;
            }
        }
    }

    setTimeout(
        typeEffect,
        deleting ? 45 : 90
    );
}

typeEffect();
